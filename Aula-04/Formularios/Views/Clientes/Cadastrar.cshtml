@model MVC2026.Cliente
@{
    ViewData["Title"] = "Cadastro de Clientes";
}

<div class="container">
    <h1 class="texte-center mt-3 fw-bold">Cadastro de Clientes</h1>
    <form action="#" method="get">

        <div class="row g-3">

            
            <div class="col-12 col-md-3">
                <label asp-for="Id" class="form-label">Código</label>
                <input type="number"
                    class="form-control"
                    placeholder="Código do Cliente"
                    asp-for="Id" />
            </div>

            
            <div class="col-12 col-md-9">
                <label asp-for="Nome" class="form-label">Nome Completo</label>
                <input type="text"
                    class="form-control"
                    placeholder="Nome Completo"
                    asp-for="Nome" />
            </div>

    
            <div class="col-12 col-md-6">
                <label asp-for="Endereco" class="form-label">Endereço</label>
                <input type="text"
                    class="form-control"
                    placeholder="Endereço"
                    asp-for="Endereco" />
            </div>

            
            <div class="col-12 col-md-6">
                <label asp-for="Bairro" class="form-label">Bairro</label>
                <input type="text"
                    class="form-control"
                    placeholder="Bairro"
                    asp-for="Bairro" />
            </div>

            <div class="col-12 col-md-2">
                <label asp-for="UF" class="form-label">UF</label>
                <input type="text"
                    class="form-control"
                    placeholder="UF"
                    asp-for="UF" />
            </div>

            
            <div class="col-12 col-md-4">
                <label asp-for="CEP" class="form-label">CEP</label>
                <input type="text"
                    class="form-control"
                    placeholder="CEP"
                    asp-for="CEP" />
            </div>

            <!-- CPF -->
            <div class="col-12 col-md-3">
                <label asp-for="CPF" class="form-label">CPF</label>
                <input type="text"
                    class="form-control"
                    placeholder="CPF"
                    asp-for="CPF" />
            </div>

            
            <div class="col-12 col-md-3">
                <label asp-for="Celular" class="form-label">Celular</label>
                <input type="tel"
                    class="form-control"
                    placeholder="Celular"
                    asp-for="Celular" />
            </div>

            
            <div class="col-12 col-md-6">
                <label asp-for="Email" class="form-label">Email</label>
                <input type="email"
                    class="form-control"
                    placeholder="Email"
                    asp-for="Email" />
            </div>

            
            <div class="col-12 col-md-3">
                <label asp-for="DataNascimento" class="form-label">
                    Data de nascimento
                </label>

                <input type="date"
                    class="form-control"
                    asp-for="DataNascimento" />
            </div>

            
            <div class="col-12 col-md-9">
                <label asp-for="Observacao" class="form-label">
                    Observação
                </label>

                <input type="text"
                    class="form-control"
                    placeholder="Observação"
                    asp-for="Observacao" />
            </div>

        </div>


        <div class="row g-3 mt-3">

            <div class="col-12 col-md-6">
                <input type="reset"
                    value="Limpar"
                    class="btn btn-outline btn-warning w-50" />
            </div>

            <div class="col-12 col-md-6">
                <input type="submit"
                    value="Enviar"
                    class="btn btn-outline btn-primary w-50" />
            </div>

        </div>

    </form>

</div>